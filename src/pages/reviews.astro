---
import Layout from "../layouts/Layout.astro";
import { restaurant } from "../data/restaurant";
import { featuredReviews } from "../data/reviews";
---

<Layout
  title="Reviews | OASIS Restaurant Tanjungpinang"
  description="What guests say about OASIS Restaurant in Tanjungpinang."
>
  <section class="bg-ivory pt-32 pb-12 lg:pt-40 lg:pb-16">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="text-[11px] uppercase tracking-[0.32em] text-copper">Reviews</div>
      <h1 class="font-display text-5xl lg:text-8xl leading-[0.95] mt-4">What people say.</h1>
    </div>
  </section>

  <section class="bg-ivory pb-12">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="flex items-baseline gap-6 border-y border-charcoal/10 py-10">
        <div class="font-display text-7xl lg:text-9xl text-forest leading-none">{restaurant.rating}</div>
        <div>
          <div class="text-copper text-3xl">★★★★★</div>
          <div class="text-charcoal/60 text-sm mt-1">Based on {restaurant.reviewCount} {restaurant.ratingSource}</div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-ivory pb-24 lg:pb-36">
    <div class="max-w-4xl mx-auto px-6 lg:px-10 space-y-12">
      {featuredReviews.map((r, i) => (
        <article class="reveal" style={`transition-delay: ${i * 60}ms`}>
          <p class="font-display italic text-3xl lg:text-4xl leading-snug">
            "{r.quote}"
          </p>
          <div class="mt-4 text-[11px] uppercase tracking-[0.22em] text-charcoal/40">
            — {r.author} · {r.source}
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>
