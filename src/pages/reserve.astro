---
import Layout from "../layouts/Layout.astro";
import Reserve from "../components/Reserve.astro";
---

<Layout
  title="Reserve a Table | OASIS Restaurant Tanjungpinang"
  description="Reserve a table at OASIS Restaurant in Tanjungpinang via WhatsApp. Quick, no account needed."
>
  <section class="bg-ivory pt-32 pb-12 lg:pt-40 lg:pb-16">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="text-[11px] uppercase tracking-[0.32em] text-copper">Reservation</div>
      <h1 class="font-display text-5xl lg:text-8xl leading-[0.95] mt-4">Save your table.</h1>
    </div>
  </section>
  <Reserve />
</Layout>
