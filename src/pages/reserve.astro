---
import Layout from "../layouts/Layout.astro";
import Reserve from "../components/Reserve.astro";
import { ui } from "../data/translations";
import { pickLang } from "../utils/i18n";

const lang = pickLang(Astro.url.searchParams.get("lang"));
const t = ui(lang);
---

<Layout
  title={lang === "en" ? "Reserve a Table | OASIS Restaurant Tanjungpinang" : "Reservasi Meja | OASIS Restaurant Tanjungpinang"}
  description={lang === "en" ? "Reserve a table at OASIS Restaurant in Tanjungpinang via WhatsApp. Quick, no account needed." : "Reservasi meja di OASIS Restaurant Tanjungpinang via WhatsApp. Cepat, tanpa akun."}
>
  <section class="bg-ivory pt-32 pb-12 lg:pt-40 lg:pb-16">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="text-[11px] uppercase tracking-[0.32em] text-copper" data-i18n="reservePage.eyebrow">{t.reservePage.eyebrow}</div>
      <h1 class="font-display text-5xl lg:text-8xl leading-[0.95] mt-4" data-i18n="reservePage.title">{t.reservePage.title}</h1>
    </div>
  </section>
  <Reserve lang={lang} />
</Layout>
