---
import Layout from "../layouts/Layout.astro";
import Location from "../components/Location.astro";
import { ui } from "../data/translations";
import { pickLang } from "../utils/i18n";

const lang = pickLang(Astro.url.searchParams.get("lang"));
const t = ui(lang);
---

<Layout
  title={lang === "en" ? "Location & Hours | OASIS Restaurant Tanjungpinang" : "Lokasi & Jam | OASIS Restaurant Tanjungpinang"}
  description={lang === "en" ? "Find OASIS Restaurant in Batu IX, Tanjungpinang. Plus code, hours, services." : "Temukan OASIS Restaurant di Batu IX, Tanjungpinang. Plus code, jam operasional, layanan."}
>
  <section class="bg-ivory pt-32 pb-12 lg:pt-40 lg:pb-16">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="text-[11px] uppercase tracking-[0.32em] text-copper" data-i18n="locationPage.eyebrow">{t.locationPage.eyebrow}</div>
      <h1 class="font-display text-5xl lg:text-8xl leading-[0.95] mt-4" data-i18n="locationPage.title">{t.locationPage.title}</h1>
    </div>
  </section>
  <Location lang={lang} />
</Layout>
