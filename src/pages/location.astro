---
import Layout from "../layouts/Layout.astro";
import Location from "../components/Location.astro";
---

<Layout
  title="Location & Hours | OASIS Restaurant Tanjungpinang"
  description="Find OASIS Restaurant in Batu IX, Tanjungpinang. Plus code, hours, services."
>
  <section class="bg-ivory pt-32 pb-12 lg:pt-40 lg:pb-16">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="text-[11px] uppercase tracking-[0.32em] text-copper">Find us</div>
      <h1 class="font-display text-5xl lg:text-8xl leading-[0.95] mt-4">Where to find OASIS.</h1>
    </div>
  </section>
  <Location />
</Layout>
