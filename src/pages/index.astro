---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Intro from "../components/Intro.astro";
import Experience from "../components/Experience.astro";
import MenuPreview from "../components/MenuPreview.astro";
import Breakfast from "../components/Breakfast.astro";
import Dessert from "../components/Dessert.astro";
import Drinks from "../components/Drinks.astro";
import HotTea from "../components/HotTea.astro";
import Gallery from "../components/Gallery.astro";
import Social from "../components/Social.astro";
import Reviews from "../components/Reviews.astro";
import Events from "../components/Events.astro";
import Reserve from "../components/Reserve.astro";
import Location from "../components/Location.astro";
import { pickLang } from "../utils/i18n";

const lang = pickLang(Astro.url.searchParams.get("lang"));
---

<Layout>
  <Hero lang={lang} />
  <Intro lang={lang} />
  <Experience lang={lang} />
  <MenuPreview lang={lang} />
  <Breakfast lang={lang} />
  <Dessert lang={lang} />
  <Drinks lang={lang} />
  <HotTea lang={lang} />
  <Gallery lang={lang} />
  <Social lang={lang} />
  <Reviews lang={lang} />
  <Events lang={lang} />
  <Reserve lang={lang} />
  <Location lang={lang} />
</Layout>
