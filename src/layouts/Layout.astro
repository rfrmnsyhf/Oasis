---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import BottomNav from "../components/mobile/BottomNav.astro";
import { restaurant } from "../data/restaurant";
import { pickLang, type Lang } from "../utils/i18n";
import { ui } from "../data/translations";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  noFooter?: boolean;
}

const {
  title = "OASIS Restaurant Tanjungpinang | Modern Dining & Dining Experience",
  description = "Discover OASIS Restaurant in Tanjungpinang. Modern dining, Asian-inspired dishes, refreshing drinks and a comfortable aesthetic space for dining, gathering and celebrations.",
  image = "/og-default.svg",
  noFooter = false,
} = Astro.props;

const lang: Lang = pickLang(Astro.url.searchParams.get("lang"));
const t = ui(lang);

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://oasis-tanjungpinang.com").toString();
const ogTitle = lang === "en"
  ? title
  : "OASIS Restaurant Tanjungpinang | Modern Dining & Pengalaman Bersantap";
const ogDescription = lang === "en"
  ? description
  : "Temukan OASIS Restaurant di Tanjungpinang. Modern dining, hidangan Asia, minuman segar, dan ruang aesthetic untuk makan, berkumpul, dan selebrasi.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  name: restaurant.name,
  description: restaurant.longDescription.en,
  address: {
    "@type": "PostalAddress",
    streetAddress: restaurant.address.line1,
    addressLocality: "Tanjungpinang",
    addressRegion: "Kepulauan Riau",
    postalCode: "29123",
    addressCountry: "ID",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: restaurant.rating,
    reviewCount: restaurant.reviewCount,
  },
  servesCuisine: ["Asian", "Indonesian", "Western"],
  priceRange: "Rp25K–Rp100K",
  openingHours: restaurant.hours.map((h) => `${h.day.en.slice(0, 2)} ${h.open}-${h.close}`),
  sameAs: [restaurant.social.instagramUrl, restaurant.social.tiktokUrl].filter(Boolean),
};
---

<!doctype html>
<html lang={lang === "en" ? "en" : "id"} data-lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#173B32" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang="id" href={new URL(Astro.url.pathname + "?lang=id", Astro.site ?? "https://oasis-tanjungpinang.com").toString()} />
    <link rel="alternate" hreflang="en" href={new URL(Astro.url.pathname + "?lang=en", Astro.site ?? "https://oasis-tanjungpinang.com").toString()} />

    <meta property="og:type" content="restaurant" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={new URL(image, Astro.site ?? "https://oasis-tanjungpinang.com").toString()} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "id_ID"} />
    <meta property="og:site_name" content="OASIS Restaurant" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={new URL(image, Astro.site ?? "https://oasis-tanjungpinang.com").toString()} />

    <meta name="keywords" content="OASIS Restaurant Tanjungpinang, restoran aesthetic Tanjungpinang, restaurant Tanjungpinang, tempat makan Tanjungpinang, restoran Batu IX, tempat nongkrong Tanjungpinang" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Manrope:wght@300;400;500;600;700&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-ivory text-charcoal antialiased" data-lang={lang}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-forest focus:text-ivory focus:px-4 focus:py-2 focus:rounded"
    >
      {t.skipToContent}
    </a>

    <Navbar lang={lang} />
    <main id="main">
      <slot />
    </main>
    {!noFooter && <Footer lang={lang} />}
    <BottomNav lang={lang} />

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
      );
      const start = () =>
        document.querySelectorAll(".reveal, .stagger").forEach((el) => io.observe(el));
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", start);
      } else {
        start();
      }
    </script>
  </body>
</html>
