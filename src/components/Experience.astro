---
import { experienceMoments, expText } from "../data/experience";
import { ui } from "../data/translations";
import type { Lang } from "../utils/i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui(lang);
---

<section id="experience" class="relative bg-charcoal text-ivory overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-10 pt-24 lg:pt-32 pb-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end reveal">
      <div class="lg:col-span-7">
        <div class="text-[11px] uppercase tracking-[0.32em] text-copper" data-i18n="experience.eyebrow">{t.experience.eyebrow}</div>
        <h2 class="font-display text-4xl sm:text-5xl lg:text-7xl leading-[0.98] mt-5" data-i18n="experience.headline">
          {t.experience.headline}
        </h2>
      </div>
      <div class="lg:col-span-5">
        <p class="text-ivory/65 text-base leading-relaxed" data-i18n="experience.body">
          {t.experience.body}
        </p>
      </div>
    </div>
  </div>

  <div
    id="xp-pin"
    class="relative h-[100vh] lg:h-[80vh] overflow-hidden"
  >
    <div id="xp-track" class="flex h-full w-[300%] lg:w-[200%]">
      {experienceMoments.map((m, i) => {
        const txt = expText(m, lang);
        return (
          <article class="xp-slide relative h-full w-screen lg:w-[50vw] flex items-center">
            <div class="absolute inset-0">
              <img
                src={m.image}
                alt={txt.title}
                class="w-full h-full object-cover opacity-70"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 cinematic-overlay"></div>
            </div>
            <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10 w-full">
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
                <div class="lg:col-span-8">
                  <div class="text-[11px] uppercase tracking-[0.32em] text-copper">{m.index}</div>
                  <h3 class="font-display text-6xl lg:text-9xl tracking-tight leading-[0.92] mt-4" data-i18n-xptitle={i}>
                    {txt.title}
                  </h3>
                  <p class="mt-6 max-w-lg text-ivory/75 text-base lg:text-lg leading-relaxed" data-i18n-xpbody={i}>
                    {txt.body}
                  </p>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-6 lg:px-10 py-12 lg:py-16">
    <div class="flex items-center justify-between text-[11px] uppercase tracking-[0.32em] text-ivory/50">
      <div>01 — 02 — 03</div>
      <div class="hidden md:block" data-i18n="experience.nav">{t.experience.nav}</div>
      <div class="flex items-center gap-2">
        <button
          id="xp-prev"
          data-i18n-attr="aria-label:experience.prev"
          aria-label={t.experience.prev}
          class="size-10 border border-ivory/30 hover:border-ivory hover:bg-ivory hover:text-charcoal transition-colors flex items-center justify-center"
        >←</button>
        <button
          id="xp-next"
          data-i18n-attr="aria-label:experience.next"
          aria-label={t.experience.next}
          class="size-10 border border-ivory/30 hover:border-ivory hover:bg-ivory hover:text-charcoal transition-colors flex items-center justify-center"
        >→</button>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const init = () => {
    const track = document.getElementById("xp-track");
    const pin = document.getElementById("xp-pin");
    if (!track || !pin) return;

    const slides = track.children;
    const total = slides.length;
    const isDesktop = window.matchMedia("(min-width: 1024px)").matches;
    const xPercent = isDesktop ? -(50 * (total - 1)) : -(100 * (total - 1));

    gsap.to(track, {
      xPercent,
      ease: "none",
      scrollTrigger: {
        trigger: pin,
        start: "top top",
        end: () => "+=" + (pin.offsetWidth * (isDesktop ? 1 : 1.2)),
        pin: true,
        scrub: 0.6,
        invalidateOnRefresh: true,
        anticipatePin: 1,
      },
    });

    const next = document.getElementById("xp-next");
    const prev = document.getElementById("xp-prev");
    let i = 0;
    const jumpTo = (idx: number) => {
      i = Math.max(0, Math.min(total - 1, idx));
      const targetX = isDesktop ? -(50 * i) : -(100 * i);
      gsap.to(track, { xPercent: targetX, duration: 0.8, ease: "power3.out" });
    };
    next?.addEventListener("click", () => jumpTo(i + 1));
    prev?.addEventListener("click", () => jumpTo(i - 1));

    window.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") jumpTo(i + 1);
      if (e.key === "ArrowLeft") jumpTo(i - 1);
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
