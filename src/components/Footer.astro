---
import { restaurant } from "../data/restaurant";
import { ui } from "../data/translations";
import type { Lang } from "../utils/i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui(lang);
const year = new Date().getFullYear();
const q = lang === "en" ? "?lang=en" : "";

const navLinks = [
  { href: `/menu${q}`, label: t.nav.menu },
  { href: `/${q}#experience`, label: t.nav.experience },
  { href: `/gallery${q}`, label: t.nav.gallery },
  { href: `/reviews${q}`, label: t.nav.reviews },
  { href: `/location${q}`, label: t.nav.location },
  { href: `/reserve${q}`, label: t.nav.reserve },
];
---

<footer class="bg-charcoal text-ivory/80 mt-0">
  <div class="max-w-7xl mx-auto px-6 lg:px-10 py-16 lg:py-24">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-8">
      <div class="md:col-span-5">
        <div class="font-display text-5xl text-ivory leading-none">OASIS</div>
        <p class="mt-4 text-ivory/60 max-w-sm text-sm leading-relaxed">
          <span data-i18n="footer.tagline">{t.footer.tagline}</span><br/><span data-i18n="footer.in">{t.footer.in}</span>
        </p>

        <div class="mt-8 flex items-center gap-5 text-[12px] uppercase tracking-[0.18em]">
          <a href={restaurant.social.instagramUrl} target="_blank" rel="noopener" class="hover:text-copper transition-colors">Instagram</a>
          <a href={restaurant.social.tiktokUrl} target="_blank" rel="noopener" class="hover:text-copper transition-colors">TikTok</a>
          {restaurant.social.gofoodUrl && (
            <a href={restaurant.social.gofoodUrl} target="_blank" rel="noopener" class="hover:text-copper transition-colors">GoFood</a>
          )}
          <a href={restaurant.social.googleMapsUrl} target="_blank" rel="noopener" class="hover:text-copper transition-colors">Maps</a>
        </div>
      </div>

      <div class="md:col-span-3">
        <div class="text-[11px] uppercase tracking-[0.22em] text-ivory/40 mb-4" data-i18n="footer.explore">{t.footer.explore}</div>
        <ul class="space-y-2.5 text-sm">
          {navLinks.map((l, i) => (
            <li>
              <a
                href={l.href}
                data-i18n={["nav.menu", "nav.experience", "nav.gallery", "nav.reviews", "nav.location", "nav.reserve"][i]}
                class="hover:text-copper transition-colors"
              >{l.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-4">
        <div class="text-[11px] uppercase tracking-[0.22em] text-ivory/40 mb-4" data-i18n="footer.visit">{t.footer.visit}</div>
        <p class="text-sm leading-relaxed">
          {restaurant.address.line1}<br/>
          <span data-i18n-addrline2>{restaurant.address.line2[lang]}</span><br/>
          {restaurant.address.province}
        </p>
        <a
          href={restaurant.social.googleMapsUrl}
          target="_blank"
          rel="noopener"
          data-i18n="location.getDirections"
          class="inline-flex items-center gap-2 mt-5 text-[12px] uppercase tracking-[0.2em] text-copper hover:text-ivory transition-colors"
        >
          {t.location.getDirections} →
        </a>
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-ivory/10 flex flex-col md:flex-row items-start md:items-center justify-between gap-3 text-[11px] uppercase tracking-[0.2em] text-ivory/40">
      <div><span data-i18n="footer.copyright">{t.footer.copyright}</span> {year} OASIS Restaurant</div>
      <div data-i18n="footer.location">{t.footer.location}</div>
    </div>
  </div>
</footer>
