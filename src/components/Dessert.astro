---
import { menu, itemName } from "../data/menu";
import { formatShort } from "../utils/formatCurrency";
import { ui } from "../data/translations";
import type { Lang } from "../utils/i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui(lang);

const items = menu.filter((i) => i.category === "dessert");
---

<section class="bg-ivory py-24 lg:py-36">
  <div class="max-w-7xl mx-auto px-6 lg:px-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-end reveal">
      <div class="lg:col-span-7">
        <div class="text-[11px] uppercase tracking-[0.32em] text-copper">{t.dessert.eyebrow}</div>
        <h2 class="font-display text-4xl sm:text-5xl lg:text-7xl leading-[0.98] mt-4">
          {t.dessert.headline1}<br/>
          <em class="italic font-light">{t.dessert.headlineEm}</em>
        </h2>
      </div>
      <div class="lg:col-span-5">
        <p class="text-charcoal/70 text-base lg:text-lg leading-relaxed">
          {t.dessert.body}
        </p>
      </div>
    </div>

    <div class="mt-14 lg:mt-20 -mx-6 lg:-mx-10 overflow-x-auto scrollbar-none">
      <ul class="flex gap-5 lg:gap-6 px-6 lg:px-10 snap-x snap-mandatory">
        {items.map((it) => (
          <li class="snap-start shrink-0 w-[70vw] sm:w-[40vw] lg:w-[26vw] group">
            <a href={`/menu${lang === "en" ? "?lang=en" : ""}`} class="block">
              <div class="relative overflow-hidden bg-mist aspect-[4/5]">
                <img
                  src={it.image}
                  alt={itemName(it, lang)}
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 group-hover:scale-[1.05]"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-charcoal/50 via-transparent to-transparent"></div>
                <div class="absolute left-5 right-5 bottom-5 text-ivory">
                  <div class="font-display text-2xl lg:text-3xl leading-tight">{itemName(it, lang)}</div>
                  <div class="mt-1 text-[12px] uppercase tracking-[0.22em] text-ivory/80">Rp {formatShort(it.price)}</div>
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
