---
import { restaurant } from "../data/restaurant";
import { ui } from "../data/translations";
import type { Lang } from "../utils/i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui(lang);
const events = t.events.types;
---

<section class="bg-charcoal text-ivory py-24 lg:py-36">
  <div class="max-w-7xl mx-auto px-6 lg:px-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-end reveal">
      <div class="lg:col-span-7">
        <div class="text-[11px] uppercase tracking-[0.32em] text-copper">{t.events.eyebrow}</div>
        <h2 class="font-display text-4xl sm:text-5xl lg:text-7xl leading-[0.98] mt-4">
          {t.events.headline1}<br/>
          <em class="italic font-light">{t.events.headlineEm}</em>
        </h2>
      </div>
      <div class="lg:col-span-5">
        <p class="text-ivory/70 text-base lg:text-lg leading-relaxed">
          {t.events.body}
        </p>
      </div>
    </div>

    <ul class="mt-14 lg:mt-20 flex flex-wrap gap-3 stagger">
      {events.map((e) => (
        <li class="px-6 py-3 border border-ivory/15 text-[12px] uppercase tracking-[0.22em] text-ivory/80 hover:border-copper hover:text-copper transition-colors">
          {e}
        </li>
      ))}
    </ul>

    <div class="mt-12">
      {restaurant.whatsapp ? (
        <a
          href={`https://wa.me/${restaurant.whatsapp.replace(/[^0-9]/g, "")}?text=${encodeURIComponent(lang === "en" ? "Hello OASIS, I'd like to plan an event." : "Halo OASIS, saya ingin merencanakan sebuah acara.")}`}
          class="inline-flex items-center gap-3 px-7 py-4 bg-ivory text-forest text-[13px] uppercase tracking-[0.22em] hover:bg-copper hover:text-ivory transition-colors"
        >
          {t.events.planLive} →
        </a>
      ) : (
        <a
          href={`/reserve${lang === "en" ? "?lang=en" : ""}`}
          class="inline-flex items-center gap-3 px-7 py-4 border border-ivory/40 text-ivory text-[13px] uppercase tracking-[0.22em] hover:bg-ivory/10 transition-colors"
        >
          {t.events.planSoon}
        </a>
      )}
    </div>
  </div>
</section>
