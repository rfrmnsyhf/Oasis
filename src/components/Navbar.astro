---
import { ui } from "../data/translations";
import type { Lang } from "../utils/i18n";
import LangSwitch from "./LangSwitch.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui(lang);
const path = Astro.url.pathname;
const sep = path.includes("?") ? "&" : "?";
const idHref = `${path}${sep}lang=id`;
const enHref = `${path}${sep}lang=en`;
const withLang = (href: string) => `${href}${sep}lang=${lang}`;

const navItems = [
  { href: withLang("/menu"), label: t.nav.menu },
  { href: withLang("/") + "#experience", label: t.nav.experience },
  { href: withLang("/gallery"), label: t.nav.gallery },
  { href: withLang("/reviews"), label: t.nav.reviews },
  { href: withLang("/location"), label: t.nav.location },
];
const reserveHref = withLang("/reserve");
---

<header
  id="site-nav"
  class="fixed top-0 inset-x-0 z-40 transition-all duration-500"
  data-state="top"
>
  <nav class="max-w-7xl mx-auto flex items-center justify-between px-6 lg:px-10 py-5 lg:py-6 gap-4">
    <a
      href={withLang("/")}
      class="font-display text-2xl lg:text-3xl tracking-tight text-ivory transition-colors duration-500"
      data-navmark
    >
      OASIS
    </a>

    <ul
      class="hidden md:flex items-center gap-7 lg:gap-9 text-[12px] uppercase tracking-[0.18em] text-ivory/85 transition-colors duration-500"
      data-navlinks
    >
      {navItems.map((l, i) => (
        <li>
          <a
            href={l.href}
            data-i18n={["nav.menu", "nav.experience", "nav.gallery", "nav.reviews", "nav.location"][i]}
            class="hover:text-copper transition-colors"
          >{l.label}</a>
        </li>
      ))}
    </ul>

    <div class="hidden md:flex items-center gap-3">
      <LangSwitch lang={lang} variant="desktop" idHref={idHref} enHref={enHref} />
      <a
        href={reserveHref}
        class="inline-flex items-center gap-2 px-5 py-2.5 text-[12px] uppercase tracking-[0.2em] border border-ivory/40 text-ivory hover:bg-ivory hover:text-forest transition-all duration-300"
        data-navcta
        data-i18n="nav.reserve"
      >
        {t.nav.reserve}
      </a>
    </div>

    <button
      id="nav-toggle"
      class="md:hidden text-ivory transition-colors"
      data-i18n-aria="nav.homeAria"
      data-i18n-attr="aria-label:nav.homeAria"
      aria-label={t.nav.homeAria}
      aria-expanded="false"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <line x1="3" y1="8" x2="21" y2="8"/>
        <line x1="3" y1="16" x2="21" y2="16"/>
      </svg>
    </button>
  </nav>

  <div
    id="nav-mobile"
    class="md:hidden hidden bg-ivory/95 backdrop-blur-lg border-t border-charcoal/10"
  >
    <ul class="flex flex-col py-6 px-6 gap-4 text-sm uppercase tracking-[0.18em] text-forest">
      {navItems.map((l, i) => (
        <li>
          <a
            href={l.href}
            data-i18n={["nav.menu", "nav.experience", "nav.gallery", "nav.reviews", "nav.location"][i]}
            class="block py-1"
          >{l.label}</a>
        </li>
      ))}
      <li>
        <a
          href={reserveHref}
          data-i18n="nav.reserve"
          class="inline-block mt-2 px-5 py-2.5 border border-forest text-forest uppercase tracking-[0.2em] text-[12px]"
        >
          {t.nav.reserve}
        </a>
      </li>
      <li>
        <LangSwitch lang={lang} variant="mobile" idHref={idHref} enHref={enHref} />
      </li>
    </ul>
  </div>
</header>

    <script>
      const nav = document.getElementById("site-nav");
      if (nav) {
        const setState = (state: "top" | "scrolled") => {
          nav.dataset.state = state;
          nav.querySelectorAll<HTMLElement>("[data-navmark]").forEach((el) => {
            if (state === "top") {
              el.classList.add("text-ivory");
              el.classList.remove("text-forest");
            } else {
              el.classList.add("text-forest");
              el.classList.remove("text-ivory");
            }
          });
          nav.querySelectorAll<HTMLElement>("[data-navlinks]").forEach((el) => {
            el.classList.toggle("text-ivory/85", state === "top");
            el.classList.toggle("text-forest/85", state === "scrolled");
          });
          nav.querySelectorAll<HTMLElement>("[data-navcta]").forEach((el) => {
            el.classList.toggle("border-ivory/40", state === "top");
            el.classList.toggle("text-ivory", state === "top");
            el.classList.toggle("hover:bg-ivory", state === "top");
            el.classList.toggle("hover:text-forest", state === "top");
            el.classList.toggle("border-forest", state === "scrolled");
            el.classList.toggle("text-forest", state === "scrolled");
            el.classList.toggle("hover:bg-forest", state === "scrolled");
            el.classList.toggle("hover:text-ivory", state === "scrolled");
          });
          nav.classList.toggle("glass", state === "scrolled");
        };

        const onScroll = () => {
          setState(window.scrollY > 40 ? "scrolled" : "top");
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();

        const toggle = document.getElementById("nav-toggle");
        const mobile = document.getElementById("nav-mobile");
        if (toggle && mobile) {
          toggle.addEventListener("click", () => {
            const open = mobile.classList.toggle("hidden") === false;
            toggle.setAttribute("aria-expanded", String(open));
          });
          mobile.querySelectorAll("a").forEach((a) =>
            a.addEventListener("click", () => mobile.classList.add("hidden")),
          );
        }
      }
    </script>
