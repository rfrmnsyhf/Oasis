---
import { ui } from "../../data/translations";
import type { Lang } from "../../utils/i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui(lang);
const langQ = lang === "en" ? "?lang=en" : "";
const items = [
  { href: `/${langQ}`, label: t.bottomNav.home, icon: "home" },
  { href: `/menu${langQ}`, label: t.bottomNav.menu, icon: "menu" },
  { href: `/gallery${langQ}`, label: t.bottomNav.gallery, icon: "gallery" },
  { href: `/reserve${langQ}`, label: t.bottomNav.reserve, icon: "reserve", primary: true },
];
---

<nav
  class="md:hidden fixed bottom-0 inset-x-0 z-30 border-t border-charcoal/10 bg-ivory/95 backdrop-blur-lg pb-[env(safe-area-inset-bottom)]"
  aria-label="Primary"
>
  <ul class="grid grid-cols-4">
    {items.map((it) => (
      <li>
        <a
          href={it.href}
          class:list={[
            "flex flex-col items-center justify-center gap-1 py-3 text-[10px] uppercase tracking-[0.18em]",
            it.primary
              ? "text-ivory bg-forest"
              : "text-charcoal/70 hover:text-forest transition-colors",
          ]}
        >
          {it.icon === "home" && (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M3 12L12 3l9 9" /><path d="M5 10v10h14V10" />
            </svg>
          )}
          {it.icon === "menu" && (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M4 6h16M4 12h16M4 18h10" />
            </svg>
          )}
          {it.icon === "gallery" && (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" />
              <rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" />
            </svg>
          )}
          {it.icon === "reserve" && (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="5" width="18" height="16" rx="2" />
              <path d="M3 9h18M8 3v4M16 3v4" />
            </svg>
          )}
          <span
            data-i18n={["bottomNav.home", "bottomNav.menu", "bottomNav.gallery", "bottomNav.reserve"][["home","menu","gallery","reserve"].indexOf(it.icon)]}
          >{it.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
