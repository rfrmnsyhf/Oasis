---
import { restaurant } from "../data/restaurant";
import { ui } from "../data/translations";
import type { Lang } from "../utils/i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui(lang);
const longDesc = lang === "en" ? restaurant.longDescription.en : restaurant.longDescription.id;
---

<section id="intro" class="bg-ivory py-24 lg:py-40">
  <div class="max-w-7xl mx-auto px-6 lg:px-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-end">
      <div class="lg:col-span-7 reveal">
        <div class="text-[11px] uppercase tracking-[0.32em] text-copper">{t.intro.eyebrow}</div>
        <h2 class="font-display text-4xl sm:text-5xl lg:text-7xl leading-[0.98] mt-5 text-charcoal">
          {t.intro.headline1}<br/>
          {t.intro.headlineEm.split(" ").slice(0, -1).join(" ")} <em class="italic font-light">{t.intro.headlineEm.split(" ").slice(-1)[0]}</em>
        </h2>
      </div>
      <div class="lg:col-span-5 reveal" style="transition-delay: .15s">
        <p class="text-charcoal/70 text-base lg:text-lg leading-relaxed">
          {longDesc}
        </p>
        <div class="mt-8 flex items-center gap-6 text-[12px] uppercase tracking-[0.22em]">
          <div>
            <div class="text-charcoal/40">{t.intro.since}</div>
            <div class="text-forest font-medium">{t.intro.sinceVal}</div>
          </div>
          <div class="w-px h-8 bg-charcoal/15"></div>
          <div>
            <div class="text-charcoal/40">{t.intro.located}</div>
            <div class="text-forest font-medium">{t.intro.locatedVal}</div>
          </div>
          <div class="w-px h-8 bg-charcoal/15"></div>
          <div>
            <div class="text-charcoal/40">{t.intro.style}</div>
            <div class="text-forest font-medium">{t.intro.styleVal}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
