---
import { menu, itemName } from "../data/menu";
import { formatShort } from "../utils/formatCurrency";
import { ui } from "../data/translations";
import type { Lang } from "../utils/i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui(lang);

const items = menu.filter((i) => i.category === "breakfast");
const lead = items[0];
const menuHref = `/menu${lang === "en" ? "?lang=en" : ""}`;
const idxOf = (it: typeof menu[number]) => menu.findIndex((m) => m.name.id === it.name.id);
---

<section class="bg-mist py-24 lg:py-36">
  <div class="max-w-7xl mx-auto px-6 lg:px-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-end reveal">
      <div class="lg:col-span-7">
        <div class="text-[11px] uppercase tracking-[0.32em] text-copper" data-i18n="breakfast.eyebrow">{t.breakfast.eyebrow}</div>
        <h2 class="font-display text-4xl sm:text-5xl lg:text-7xl leading-[0.98] mt-4">
          <span data-i18n="breakfast.headline1">{t.breakfast.headline1}</span><br/>
          <em data-i18n="breakfast.headlineEm" class="italic font-light">{t.breakfast.headlineEm}</em>
        </h2>
      </div>
      <div class="lg:col-span-5">
        <p class="text-charcoal/70 text-base lg:text-lg leading-relaxed" data-i18n="breakfast.body">
          {t.breakfast.body}
        </p>
      </div>
    </div>

    <div class="mt-14 lg:mt-20 grid grid-cols-2 lg:grid-cols-4 gap-3 lg:gap-5 stagger">
      <a
        href={menuHref}
        class="group col-span-2 lg:col-span-2 row-span-2 relative overflow-hidden bg-charcoal"
      >
        <div class="aspect-[4/5] lg:aspect-auto lg:h-full">
          <img
            src={lead.image}
            alt={itemName(lead, lang)}
            class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-[1.04]"
            loading="lazy"
          />
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-charcoal/85 via-transparent to-transparent"></div>
        <div class="absolute left-6 right-6 bottom-6 text-ivory">
          <div class="font-display text-3xl lg:text-4xl leading-tight" data-i18n-name={idxOf(lead)}>{itemName(lead, lang)}</div>
          <div class="mt-2 text-[12px] uppercase tracking-[0.22em] text-ivory/80">Rp {formatShort(lead.price)}</div>
        </div>
      </a>

      {items.slice(1, 7).map((it) => (
        <a
          href={menuHref}
          class="group relative overflow-hidden bg-ivory border border-charcoal/10"
        >
          <div class="aspect-square overflow-hidden">
            <img
              src={it.image}
              alt={itemName(it, lang)}
              class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-[1.04]"
              loading="lazy"
            />
          </div>
          <div class="p-4 flex items-end justify-between gap-2">
            <div class="font-display text-lg leading-tight" data-i18n-name={idxOf(it)}>{itemName(it, lang)}</div>
            <div class="text-[12px] text-charcoal/60">Rp {formatShort(it.price)}</div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
