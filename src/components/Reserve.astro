---
import { restaurant } from "../data/restaurant";
---

<section id="reserve" class="bg-forest text-ivory py-24 lg:py-36">
  <div class="max-w-7xl mx-auto px-6 lg:px-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <div class="lg:col-span-5 reveal">
        <div class="text-[11px] uppercase tracking-[0.32em] text-copper">Reservation</div>
        <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl leading-[0.98] mt-4">
          Save your table.
        </h2>
        <p class="mt-5 text-ivory/75 leading-relaxed">
          A short form. Your reservation is confirmed via WhatsApp — no account, no app.
        </p>

        <div class="mt-8 space-y-2 text-sm text-ivory/70">
          <div class="flex items-center gap-3">
            <span class="text-copper">1.</span> Fill in your details
          </div>
          <div class="flex items-center gap-3">
            <span class="text-copper">2.</span> We open WhatsApp with a draft message
          </div>
          <div class="flex items-center gap-3">
            <span class="text-copper">3.</span> We confirm within the hour
          </div>
        </div>
      </div>

      <form
        id="reserve-form"
        class="lg:col-span-7 bg-ivory/5 border border-ivory/10 p-6 lg:p-10 backdrop-blur-sm reveal"
        style="transition-delay: .1s"
      >
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <label class="block">
            <span class="text-[10px] uppercase tracking-[0.28em] text-ivory/60">Date</span>
            <input
              required
              type="date"
              name="date"
              class="mt-2 w-full bg-transparent border-b border-ivory/30 focus:border-copper outline-none py-2 text-ivory"
            />
          </label>
          <label class="block">
            <span class="text-[10px] uppercase tracking-[0.28em] text-ivory/60">Time</span>
            <select
              required
              name="time"
              class="mt-2 w-full bg-transparent border-b border-ivory/30 focus:border-copper outline-none py-2 text-ivory"
            >
              <option class="text-charcoal" value="">Select time</option>
              {["11:00","11:30","12:00","12:30","13:00","13:30","14:00","18:00","18:30","19:00","19:30","20:00","20:30","21:00"].map((t) => (
                <option class="text-charcoal" value={t}>{t}</option>
              ))}
            </select>
          </label>
          <label class="block">
            <span class="text-[10px] uppercase tracking-[0.28em] text-ivory/60">Guests</span>
            <select
              required
              name="guests"
              class="mt-2 w-full bg-transparent border-b border-ivory/30 focus:border-copper outline-none py-2 text-ivory"
            >
              <option class="text-charcoal" value="">Select</option>
              {[1,2,3,4,5,6,7,8,"9+"].map((n) => (
                <option class="text-charcoal" value={String(n)}>{n} {Number(n) === 1 ? "Guest" : "Guests"}</option>
              ))}
            </select>
          </label>
          <label class="block">
            <span class="text-[10px] uppercase tracking-[0.28em] text-ivory/60">Name</span>
            <input
              required
              type="text"
              name="name"
              class="mt-2 w-full bg-transparent border-b border-ivory/30 focus:border-copper outline-none py-2 text-ivory placeholder:text-ivory/30"
              placeholder="Your name"
            />
          </label>
        </div>

        <label class="block mt-6">
          <span class="text-[10px] uppercase tracking-[0.28em] text-ivory/60">WhatsApp number</span>
          <input
            required
            type="tel"
            name="phone"
            class="mt-2 w-full bg-transparent border-b border-ivory/30 focus:border-copper outline-none py-2 text-ivory placeholder:text-ivory/30"
            placeholder="08xx"
          />
        </label>

        <button
          type="submit"
          class="mt-8 w-full sm:w-auto inline-flex items-center justify-center gap-3 px-7 py-4 bg-ivory text-forest text-[13px] uppercase tracking-[0.22em] hover:bg-copper hover:text-ivory transition-colors"
        >
          {restaurant.whatsapp ? "Continue on WhatsApp" : "Coming soon — notify me"}
        </button>
        <p class="mt-4 text-[11px] uppercase tracking-[0.22em] text-ivory/40">
          {restaurant.whatsapp
            ? "We'll open WhatsApp with your reservation details ready to send."
            : "Reservations open soon. We'll notify you when available."}
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  import { buildReservationLink } from "../utils/reservation";

  const form = document.getElementById("reserve-form") as HTMLFormElement | null;
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const link = buildReservationLink({
      name: String(fd.get("name") ?? ""),
      date: String(fd.get("date") ?? ""),
      time: String(fd.get("time") ?? ""),
      guests: String(fd.get("guests") ?? ""),
    });
    if (link) {
      window.open(link, "_blank", "noopener");
    } else {
      alert("Reservasi via WhatsApp akan segera tersedia. Silakan cek kembali nanti.");
    }
  });
</script>
