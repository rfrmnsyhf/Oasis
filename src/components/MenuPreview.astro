---
import { menu, itemName, itemDescription } from "../data/menu";
import { formatShort } from "../utils/formatCurrency";
import { ui } from "../data/translations";
import type { Lang } from "../utils/i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui(lang);

const featured = menu.filter((i) => i.featured);
const lead = featured[0];
const rest = featured.slice(1, 5);
const menuHref = `/menu${lang === "en" ? "?lang=en" : ""}`;
---

<section id="menu-preview" class="bg-ivory py-24 lg:py-36">
  <div class="max-w-7xl mx-auto px-6 lg:px-10">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 reveal">
      <div>
        <div class="text-[11px] uppercase tracking-[0.32em] text-copper">{t.favourites.eyebrow}</div>
        <h2 class="font-display text-4xl sm:text-5xl lg:text-7xl leading-[0.98] mt-4">
          {t.favourites.headline1}<br/>
          <em class="italic font-light">{t.favourites.headlineEm}</em>
        </h2>
      </div>
      <a
        href={menuHref}
        class="self-start md:self-end inline-flex items-center gap-2 text-[12px] uppercase tracking-[0.22em] text-forest hover:text-copper transition-colors"
      >
        {t.favourites.viewAll} →
      </a>
    </div>

    <div class="mt-14 lg:mt-20 grid grid-cols-1 lg:grid-cols-12 gap-5 lg:gap-6 stagger">
      <a
        href={menuHref}
        class="group lg:col-span-7 lg:row-span-2 relative overflow-hidden bg-charcoal"
      >
        <div class="aspect-[4/5] lg:aspect-auto lg:h-full">
          <img
            src={lead.image}
            alt={itemName(lead, lang)}
            class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-[1.04]"
            loading="lazy"
          />
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-charcoal/85 via-charcoal/20 to-transparent"></div>
        <div class="absolute left-7 right-7 bottom-7 text-ivory">
          <div class="text-[10px] uppercase tracking-[0.32em] text-copper/90">{t.favourites.signature}</div>
          <h3 class="font-display text-3xl lg:text-5xl leading-tight mt-3">{itemName(lead, lang)}</h3>
          <p class="mt-3 text-ivory/80 text-sm max-w-md leading-relaxed line-clamp-2">{itemDescription(lead, lang)}</p>
          <div class="mt-4 flex items-center justify-between text-[12px] uppercase tracking-[0.22em]">
            <span>Rp {formatShort(lead.price)}</span>
            <span class="text-copper group-hover:translate-x-1 transition-transform">{t.favourites.readMore} →</span>
          </div>
        </div>
      </a>

      {rest.map((item) => (
        <a
          href={menuHref}
          class="group relative overflow-hidden bg-charcoal lg:col-span-5"
        >
          <div class="aspect-[4/3] lg:aspect-[16/10]">
            <img
              src={item.image}
              alt={itemName(item, lang)}
              class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-[1.04]"
              loading="lazy"
            />
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-charcoal/80 via-charcoal/10 to-transparent"></div>
          <div class="absolute left-5 right-5 bottom-5 text-ivory flex items-end justify-between gap-3">
            <div>
              <div class="font-display text-2xl lg:text-3xl leading-tight">{itemName(item, lang)}</div>
              <div class="text-[12px] uppercase tracking-[0.22em] text-ivory/70 mt-1">Rp {formatShort(item.price)}</div>
            </div>
            <span class="text-copper text-sm group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
