---
import { restaurant } from "../data/restaurant";
import { featuredReviews } from "../data/reviews";
---

<section class="bg-ivory py-24 lg:py-36">
  <div class="max-w-7xl mx-auto px-6 lg:px-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-end reveal">
      <div class="lg:col-span-5">
        <div class="text-[11px] uppercase tracking-[0.32em] text-copper">What people say</div>
        <div class="mt-6 flex items-baseline gap-3">
          <div class="font-display text-7xl lg:text-9xl text-forest leading-none">{restaurant.rating}</div>
          <div class="text-charcoal/40 text-sm leading-tight">
            / 5<br/>
            <span class="text-copper text-2xl">★★★★★</span>
          </div>
        </div>
        <p class="mt-4 text-sm text-charcoal/60 max-w-xs">
          Based on {restaurant.reviewCount} {restaurant.ratingSource}.
        </p>
        <a
          href="/reviews"
          class="inline-flex items-center gap-2 mt-6 text-[12px] uppercase tracking-[0.22em] text-forest hover:text-copper transition-colors"
        >
          Read all reviews →
        </a>
      </div>

      <div class="lg:col-span-7">
        <ul class="space-y-8">
          {featuredReviews.map((r, i) => (
            <li class="reveal" style={`transition-delay: ${i * 80}ms`}>
              <p class="font-display italic text-2xl lg:text-3xl leading-snug text-charcoal">
                "{r.quote}"
              </p>
              <div class="mt-3 text-[11px] uppercase tracking-[0.22em] text-charcoal/40">
                — {r.author} · {r.source}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
