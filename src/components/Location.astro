---
import { restaurant } from "../data/restaurant";
import { ui } from "../data/translations";
import type { Lang } from "../utils/i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui(lang);
const mapsEmbed = "https://www.google.com/maps?q=" + encodeURIComponent(restaurant.address.line1 + ", " + restaurant.address.line2.en) + "&output=embed";
const services = lang === "en" ? restaurant.services.en : restaurant.services.id;
---

<section id="location" class="bg-ivory py-24 lg:py-36">
  <div class="max-w-7xl mx-auto px-6 lg:px-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-end reveal">
      <div class="lg:col-span-7">
        <div class="text-[11px] uppercase tracking-[0.32em] text-copper" data-i18n="location.eyebrow">{t.location.eyebrow}</div>
        <h2 class="font-display text-4xl sm:text-5xl lg:text-7xl leading-[0.98] mt-4" data-i18n="location.headline">
          {t.location.headline}
        </h2>
      </div>
      <div class="lg:col-span-5">
        <a
          href={restaurant.social.googleMapsUrl}
          target="_blank"
          rel="noopener"
          data-i18n="location.getDirections"
          class="inline-flex items-center gap-2 text-[12px] uppercase tracking-[0.22em] text-forest hover:text-copper transition-colors"
        >
          {t.location.getDirections} →
        </a>
      </div>
    </div>

    <div class="mt-14 lg:mt-20 grid grid-cols-1 lg:grid-cols-12 gap-6">
      <div class="lg:col-span-7 relative overflow-hidden bg-mist aspect-[4/3] lg:aspect-auto lg:min-h-[420px] reveal">
        <iframe
          src={mapsEmbed}
          title="OASIS location map"
          class="absolute inset-0 w-full h-full"
          style="border:0;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>

      <div class="lg:col-span-5 space-y-8 reveal" style="transition-delay: .12s">
        <div>
          <div class="text-[10px] uppercase tracking-[0.28em] text-charcoal/40" data-i18n="location.address">{t.location.address}</div>
          <p class="mt-2 text-lg leading-relaxed">
            {restaurant.address.line1}<br/>
            <span data-i18n-addrline2>{restaurant.address.line2[lang]}</span><br/>
            {restaurant.address.province}
          </p>
          <div class="mt-2 text-[11px] uppercase tracking-[0.22em] text-copper">
            {restaurant.address.plusCode}
          </div>
        </div>

        <div>
          <div class="text-[10px] uppercase tracking-[0.28em] text-charcoal/40 mb-3" data-i18n="location.hours">{t.location.hours}</div>
          <ul class="space-y-1.5 text-sm">
            {restaurant.hours.map((h) => (
              <li class="flex items-baseline justify-between border-b border-charcoal/10 pb-1.5">
                <span class="text-charcoal/80" data-i18n-day={h.day.id}>{h.day[lang]}</span>
                <span class="text-charcoal/60 tabular-nums">{h.open} – {h.close}</span>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <div class="text-[10px] uppercase tracking-[0.28em] text-charcoal/40 mb-3" data-i18n="location.services">{t.location.services}</div>
          <ul class="flex flex-wrap gap-2">
            {services.map((s, i) => (
              <li data-i18n-service={i} class="px-4 py-2 text-[12px] uppercase tracking-[0.22em] border border-charcoal/15 text-charcoal/80">
                {s}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
