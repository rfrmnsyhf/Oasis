---
import { gallery, galleryAlt, galleryTagText } from "../data/gallery";
import { ui } from "../data/translations";
import type { Lang } from "../utils/i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui(lang);
---

<section class="bg-ivory py-24 lg:py-36">
  <div class="max-w-7xl mx-auto px-6 lg:px-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-end reveal">
      <div class="lg:col-span-7">
        <div class="text-[11px] uppercase tracking-[0.32em] text-copper" data-i18n="gallery.eyebrow">{t.gallery.eyebrow}</div>
        <h2 class="font-display text-4xl sm:text-5xl lg:text-7xl leading-[0.98] mt-4">
          <span data-i18n="gallery.headline1">{t.gallery.headline1}</span><br/>
          <em data-i18n="gallery.headlineEm" class="italic font-light">{t.gallery.headlineEm}</em>
        </h2>
      </div>
      <div class="lg:col-span-5">
        <p class="text-charcoal/70 text-base lg:text-lg leading-relaxed" data-i18n="gallery.body">
          {t.gallery.body}
        </p>
        <a
          href={`/gallery${lang === "en" ? "?lang=en" : ""}`}
          data-i18n="gallery.seeAll"
          class="inline-flex items-center gap-2 mt-5 text-[12px] uppercase tracking-[0.22em] text-forest hover:text-copper transition-colors"
        >
          {t.gallery.seeAll} →
        </a>
      </div>
    </div>

    <div class="mt-14 lg:mt-20 grid grid-cols-2 lg:grid-cols-4 auto-rows-[120px] sm:auto-rows-[160px] lg:auto-rows-[180px] gap-3 lg:gap-4">
      {gallery.slice(0, 8).map((g, i) => {
        const span =
          g.span === "tall" ? "row-span-2" :
          g.span === "wide" ? "col-span-2" : "";
        return (
          <a
            href={g.src}
            target="_blank"
            rel="noopener"
            class:list={["group relative overflow-hidden bg-charcoal reveal", span]}
            style={`transition-delay: ${i * 60}ms`}
          >
            <img
              src={g.src}
              data-i18n-alt={i}
              alt={galleryAlt(g, lang)}
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 group-hover:scale-[1.06]"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-charcoal/0 group-hover:bg-charcoal/20 transition-colors duration-500"></div>
            <div
              data-i18n-tag={g.tag}
              class="absolute left-3 bottom-3 text-[10px] uppercase tracking-[0.22em] text-ivory/0 group-hover:text-ivory/90 transition-colors"
            >
              {galleryTagText(g.tag, lang)}
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
